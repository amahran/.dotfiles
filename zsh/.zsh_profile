# tmux sessionizer shortcut
# Note: ~/.local/{scripts,bin} are added to PATH in ~/.zprofile so the X
# session inherits them; no need to repeat the export here.
bindkey -s ^f "tmux-sessionizer\n"

# Function to open your TODO directory in vim
todo() {
  local file=$(find ~/work/todo ~/personal/todo -type f | fzf)
  [ -n "$file" ] && nvim "$file"
}

# alt + e to open todo
bindkey -s '\ee' "todo\n"

# alias
# use zoxide instead of cd
alias cd=z
alias cdi=zi
alias xclip='xclip -selection clipboard'
